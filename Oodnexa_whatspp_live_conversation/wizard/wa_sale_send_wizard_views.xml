<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_sale_send_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.automation.sale.send.wizard.form</field>
        <field name="model">whatsapp.automation.sale.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Quotation via WhatsApp (API)">
                <group>
                    <group string="Recipient Information">
                        <field name="order_id"/>
                        <field name="partner_id"/>
                        <field name="phone" placeholder="+971501234567"/>
                    </group>
                    <group string="Provider &amp; Delivery">
                        <field name="provider_id" options="{'no_create': True}"/>
                        <field name="template_id" options="{'no_create': True}"/>
                        <field name="send_mode" widget="radio"/>
                    </group>
                </group>

                <notebook>
                    <page string="Message Preview">
                        <group>
                            <field name="preview_header" readonly="1" invisible="not preview_header"/>
                            <field name="preview_body" readonly="1" widget="text" style="font-family: monospace; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px;"/>
                            <field name="preview_footer" readonly="1" invisible="not preview_footer"/>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_send_whatsapp"
                            type="object"
                            string="Send WhatsApp"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wa_sale_send_wizard" model="ir.actions.act_window">
        <field name="name">Send Quotation via WhatsApp (API)</field>
        <field name="res_model">whatsapp.automation.sale.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
