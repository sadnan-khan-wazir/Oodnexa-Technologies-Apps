<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--                  CATEGORY VIEWS                              -->
    <!-- ============================================================ -->

    <!-- List View -->
    <record id="view_wa_category_list" model="ir.ui.view">
        <field name="name">whatsapp.automation.category.list</field>
        <field name="model">whatsapp.automation.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="rule_count"/>
                <field name="template_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wa_category_form" model="ir.ui.view">
        <field name="name">whatsapp.automation.category.form</field>
        <field name="model">whatsapp.automation.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                            <field name="rule_count"/>
                            <field name="template_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

   

    <!-- Action -->
    <record id="action_wa_category_list" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">whatsapp.automation.category</field>
        <field name="view_mode">list,form</field>
      
    </record>
</odoo>
