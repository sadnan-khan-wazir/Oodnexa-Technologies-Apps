<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--                  QUEUE VIEWS                                 -->
    <!-- ============================================================ -->

    <!-- List View -->
    <record id="view_wa_queue_list" model="ir.ui.view">
        <field name="name">whatsapp.automation.queue.list</field>
        <field name="model">whatsapp.automation.queue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-success="state == 'done'"
                  decoration-warning="state == 'processing'">
                <field name="message_id"/>
                <field name="scheduled_for"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'processing'"
                       decoration-info="state in ('pending', 'scheduled')"/>
                <field name="attempts"/>
                <field name="max_attempts"/>
                <field name="last_attempt_at" optional="show"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="locked_by" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wa_queue_form" model="ir.ui.view">
        <field name="name">whatsapp.automation.queue.form</field>
        <field name="model">whatsapp.automation.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="message_id"/>
                            <field name="scheduled_for"/>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                        </group>
                        <group>
                            <field name="last_attempt_at"/>
                            <field name="next_attempt_at"/>
                            <field name="locked_by"/>
                            <field name="lock_expires_at"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_detail">
                        <field name="error_detail" readonly="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

   
    <!-- Action -->
    <record id="action_wa_queue_list" model="ir.actions.act_window">
        <field name="name">Message Queue</field>
        <field name="res_model">whatsapp.automation.queue</field>
        <field name="view_mode">list,form</field>
     
    </record>
</odoo>
