<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!--             DEFAULT SYSTEM WHATSAPP TEMPLATES                -->
        <!-- ============================================================ -->

        <!-- Quotation Notification with PDF and Portal Link -->
        <record id="template_quotation_notification" model="whatsapp.automation.template">
            <field name="name">Quotation Notification</field>
            <field name="category_id" ref="Oodnexa_whatspp_live_conversation.category_sales"/>
            <field name="template_type">text</field>
            <field name="header_type">document</field>
            <field name="language_code">en</field>
            <field name="body_text">Dear {{customer_name}},

Thank you for your interest! Please find attached quotation {{order_number}} for a total of {{order_total}}.

You can view and approve your quotation online via your customer portal:
{{portal_url}}

If you have any questions or require modifications, feel free to reply directly to this message.

Best regards,
{{company_name}}</field>
            <field name="footer_text">Sent via WhatsApp</field>
            <field name="approval_status">approved</field>
            <field name="active">True</field>
        </record>

        <!-- Sales Order Receipt with PDF -->
        <record id="template_tailor_order_receipt" model="whatsapp.automation.template">
            <field name="name">Order Receipt with PDF</field>
            <field name="category_id" ref="Oodnexa_whatspp_live_conversation.category_sales"/>
            <field name="template_type">text</field>
            <field name="header_type">document</field>
            <field name="language_code">en</field>
            <field name="body_text">Dear {{customer_name}},

Thank you for trusting {{company_name}} with your order!

Your order details for {{order_number}} are attached as a PDF report.

Order Date: {{order_date}}
Total Amount: {{order_total}}

We will notify you once your order is processed.

Warm regards,
{{company_name}}</field>
            <field name="footer_text">Sent via WhatsApp</field>
            <field name="approval_status">approved</field>
            <field name="active">True</field>
        </record>

        <!-- Customer Portal Access Link -->
        <record id="template_customer_portal_link" model="whatsapp.automation.template">
            <field name="name">Customer Portal Link</field>
            <field name="category_id" ref="Oodnexa_whatspp_live_conversation.category_crm"/>
            <field name="template_type">text</field>
            <field name="header_type">none</field>
            <field name="language_code">en</field>
            <field name="body_text">Dear {{customer_name}},

Welcome to {{company_name}}!

You can access your dedicated customer portal to view your orders, quotations, invoices, and profile at any time using the link below:

{{portal_url}}

Please do not hesitate to contact us if you need any assistance.

Warm regards,
{{company_name}}</field>
            <field name="footer_text">Customer Portal Access</field>
            <field name="approval_status">approved</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
